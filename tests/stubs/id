#!/usr/bin/env bash
#
# Fake id for the praetorian-sudo-setup tests: "id -u" answers
# $FAKE_UID (0 = root); anything else goes to the real id.
#
if [[ "${1:-}" == -u && -n "${FAKE_UID:-}" ]]; then
    echo "${FAKE_UID}"
    exit 0
fi
stubs=$(cd "$(dirname "$0")" && pwd)
PATH=${PATH//"${stubs}:"/}
exec id "$@"
