#!/usr/bin/env bash
#
# Fake port (MacPorts) for the tests: records every call in $PORT_CALLS
# and answers according to environment variables set by the test.
# Installed by the test as $PRAETORIAN_PORT_PREFIX/bin/port.
#
#   PORT_VERSION_OUTPUT / PORT_VERSION_RC   port version
#   PORT_SELFUPDATE_OUTPUT / PORT_SELFUPDATE_RC   port selfupdate
#   PORT_OUTDATED          outdated ports (space-separated)
#   PORT_OUTDATED_AFTER    ports still outdated after "port upgrade"
#   PORT_UPGRADE_OUTPUT / PORT_UPGRADE_RC   port upgrade
#   PORT_INSTALL_OUTPUT / PORT_INSTALL_RC   port install
#   PORT_ACTIVE            ports already installed and active (port
#                          installed <name>), before any "port install"
#   PORT_AVAILABLE         known ports (port echo all, port info)
#   PORT_CONTENTS          installed files (port contents), created by
#                          "port install" when under the prefix
#   PORT_FILES             files per port, relative to the prefix:
#                          "p=bin/a,bin/b q=sbin/c" (created by "port
#                          install p", listed by "port contents p")
#   PORT_INFO              per port "p=version_revision,homepage,license"
#                          (port info --line …; default 1.0_0, no
#                          homepage, MIT)
#   PORT_DEFAULT_VARIANTS  "p=a,b": default variants (port variants p)
#   PORT_SELECT            "group=selected=opt1,opt2 …" (port select
#                          --summary); "port select --set g o" records o
#   PORT_SELECT_FILES      "opt=bin/name …": created by "port select --set
#                          <group> opt"
#   PORT_INACTIVE          inactive versions (port installed inactive),
#                          gone after "port uninstall inactive"
#   PORT_LEAVES            unrequested, unused ports (port echo leaves)
#   PORT_REQUESTED         ports marked as requested (port echo requested)
#   PORT_INSTALLED         installed ports (port echo installed; default:
#                          PORT_ACTIVE + PORT_REQUESTED + PORT_LEAVES)
#
set -u
printf '%s\n' "$*" >>"${PORT_CALLS:?}"
state="${PORT_CALLS}.state"

# Global options (-N, -p, -q…) ignored.
while [[ "${1:-}" == -* ]]; do shift; done

case "${1:-}" in
    version)
        echo "${PORT_VERSION_OUTPUT:-Version: 2.12.0}"
        exit "${PORT_VERSION_RC:-0}"
        ;;
    selfupdate)
        echo "--->  Updating the ports tree"
        [[ -z "${PORT_SELFUPDATE_OUTPUT:-}" ]] || echo "${PORT_SELFUPDATE_OUTPUT}"
        exit "${PORT_SELFUPDATE_RC:-0}"
        ;;
    outdated)
        list=${PORT_OUTDATED:-}
        [[ -e "${state}.upgraded" ]] && list=${PORT_OUTDATED_AFTER:-}
        if [[ -z "${list}" ]]; then
            echo "No installed ports are outdated."
        else
            echo "The following installed ports are outdated:"
            for p in ${list}; do printf '%-30s 1.0_0 < 1.1_0\n' "${p}"; done
        fi
        ;;
    upgrade)
        touch "${state}.upgraded"
        [[ -z "${PORT_UPGRADE_OUTPUT:-}" ]] || echo "${PORT_UPGRADE_OUTPUT}"
        exit "${PORT_UPGRADE_RC:-0}"
        ;;
    uninstall)
        [[ "${2:-}" != inactive ]] || touch "${state}.inactive_removed"
        ;;
    install)
        rc=${PORT_INSTALL_RC:-0}
        [[ -z "${PORT_INSTALL_OUTPUT:-}" ]] || echo "${PORT_INSTALL_OUTPUT}"
        [[ "${rc}" -ne 0 ]] || touch "${state}.installed.$2"
        if [[ "${rc}" -eq 0 ]]; then
            for f in ${PORT_CONTENTS:-}; do
                [[ "${f}" != "${PRAETORIAN_PORT_PREFIX:-/nonexistent}"/* ]] || { mkdir -p "${f%/*}" && touch "${f}"; }
            done
            for entry in ${PORT_FILES:-}; do
                [[ "${entry%%=*}" == "$2" ]] || continue
                files=${entry#*=}
                for f in ${files//,/ }; do mkdir -p "${PRAETORIAN_PORT_PREFIX}/${f%/*}" && touch "${PRAETORIAN_PORT_PREFIX}/${f}"; done
            done
        fi
        exit "${rc}"
        ;;
    installed)
        if [[ "${2:-}" == inactive ]]; then
            if [[ -n "${PORT_INACTIVE:-}" && ! -e "${state}.inactive_removed" ]]; then
                echo "The following ports are currently installed:"
                for p in ${PORT_INACTIVE}; do echo "  ${p} @1.0_0"; done
            else
                echo "None of the specified ports are installed."
            fi
        elif [[ -e "${state}.installed.${2:-}" || " ${PORT_ACTIVE:-} " == *" ${2:-} "* ]]; then
            echo "The following ports are currently installed:"
            echo "  $2 @1.1_0 (active)"
        else
            echo "None of the specified ports are installed."
        fi
        ;;
    contents)
        echo "Port $2 contains:"
        for f in ${PORT_CONTENTS:-}; do echo "  ${f}"; done
        for entry in ${PORT_FILES:-}; do
            [[ "${entry%%=*}" == "$2" ]] || continue
            files=${entry#*=}
            for f in ${files//,/ }; do echo "  ${PRAETORIAN_PORT_PREFIX}/${f}"; done
        done
        ;;
    variants)
        defaults=""
        for entry in ${PORT_DEFAULT_VARIANTS:-}; do [[ "${entry%%=*}" != "$2" ]] || defaults=${entry#*=}; done
        if [[ -z "${defaults}" ]]; then
            echo "$2 has no variants"
        else
            echo "$2 has the variants:"
            for v in ${defaults//,/ }; do echo "[+]${v}: default variant ${v}"; done
            echo "   universal: Build for multiple architectures"
        fi
        ;;
    select)
        if [[ "${2:-}" == --set ]]; then
            echo "$4" >"${state}.select.$3"
            for entry in ${PORT_SELECT_FILES:-}; do
                [[ "${entry%%=*}" != "$4" ]] || { mkdir -p "${PRAETORIAN_PORT_PREFIX}/bin" && touch "${PRAETORIAN_PORT_PREFIX}/${entry#*=}"; }
            done
            echo "Selecting '$4' for '$3' succeeded."
        else
            printf '%-12s%-15s%s\n' Name Selected Options "====" "========" "======="
            for entry in ${PORT_SELECT:-}; do
                g=${entry%%=*}
                rest=${entry#*=}
                sel=${rest%%=*}
                [[ ! -e "${state}.select.${g}" ]] || sel=$(cat "${state}.select.${g}")
                opts=${rest#*=}
                printf '%-12s%-15s%s none\n' "${g}" "${sel}" "${opts//,/ }"
            done
        fi
        ;;
    info)
        name=${!#}
        if [[ " ${PORT_AVAILABLE:-} " == *" ${name} "* && " $* " == *" --line "* ]]; then
            meta="1.0_0,,MIT"
            for entry in ${PORT_INFO:-}; do [[ "${entry%%=*}" != "${name}" ]] || meta=${entry#*=}; done
            vr=${meta%%,*} rest=${meta#*,}
            line=""
            for arg in "$@"; do
                case "${arg}" in
                    --version) line+="${vr%_*}"$'\t' ;;
                    --revision) line+="${vr##*_}"$'\t' ;;
                    --homepage) line+="${rest%%,*}"$'\t' ;;
                    --license) line+="${rest#*,}"$'\t' ;;
                esac
            done
            echo "${line%$'\t'}"
        elif [[ " ${PORT_AVAILABLE:-} " == *" ${name} "* ]]; then
            echo "${name}"
        else
            echo "Error: Port ${name} not found"
            exit 1
        fi
        ;;
    echo)
        if [[ "${2:-}" == all ]]; then
            for p in ${PORT_AVAILABLE:-}; do echo "${p}"; done
        elif [[ "${2:-}" == *'*'* ]]; then
            # shellcheck disable=SC2053  # $2 is a glob on purpose
            for p in ${PORT_AVAILABLE:-}; do [[ "${p}" != $2 ]] || echo "${p}"; done
        elif [[ "${2:-}" == leaves ]]; then
            for p in ${PORT_LEAVES:-}; do printf '%-30s @1.0_0\n' "${p}"; done
        elif [[ "${2:-}" == requested ]]; then
            for p in ${PORT_REQUESTED:-}; do echo "${p}"; done
        elif [[ "${2:-}" == installed ]]; then
            for p in ${PORT_INSTALLED-${PORT_ACTIVE:-} ${PORT_REQUESTED:-} ${PORT_LEAVES:-}}; do echo "${p}"; done
        fi
        ;;
esac
exit 0
