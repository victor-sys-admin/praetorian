# praetorian local state (machine-specific, may contain paths), present
# when PRAETORIAN_HOME is the repository (the default ~/praetorian).
logs/
quarantine.tsv
migrated.tsv
.toolchain
# macOS version of the last session
.macos_version
.lock/
# Lock taken over from a crashed session, while it is being removed
.lock.stale.*
# Caskroom/<cask> copy while a half-installed cask is reinstalled
.cask_backup.*
