#
# praetorian — Homebrew and MacPorts maintenance for macOS
#
# Runs, in order: brew update, upgrade (formulae + casks), autoremove,
# cleanup, then MacPorts maintenance (selfupdate, upgrade, cleanup) and
# brew doctor. Keeps going when a step fails, logs every detail, and
# lists the apps not opened in the last 6 months.
#
# The code is split by topic in lib/ (see the loading section below);
# this file holds the constants, the options and main.
#
# Terminal output stays short on purpose: the full output of every
# command is in the session log.
#
# What changed in each version: CHANGELOG.md.
#
# Usage   : ./praetorian [--dry-run] [--no-greedy] [--retry-quarantined]
#                        [--unattended] [--notify | --no-notify]
#                        [--ac-power-only] [--quiet] [--help]
#           ./praetorian --migration-report | --status | --doctor | --sbom
#           ./praetorian [--dry-run] --prune
#           ./praetorian [--dry-run] [--allow-build] --migrate <formula>[=<port>[,<port>…]] [--migrate …]
#           ./praetorian [--dry-run] [--allow-build] --migrate-all
#           (--migrate=<spec> works too; -h = --help)
# Author  : victor-sys-admin
# License : GPL-3.0-or-later (see LICENSE)
#
# Exit codes:
#   0   full success
#   1   prerequisite error (no package manager, root, Xcode not ready,
#       disk full, on battery with --ac-power-only, no network when
#       unattended, another session running, invalid PRAETORIAN_HOME) or
#       migration report blocked
#   2   one or more steps failed or were blocked
#   130 interrupted (Ctrl-C)
#
set -euo pipefail

# ----------------------------------------------------------------------------
# Constants
# ----------------------------------------------------------------------------
readonly PRAETORIAN_VERSION="1.5.1"
# State directory (logs, quarantine, lock): PRAETORIAN_HOME from the
# environment, ~/praetorian by default. Checked by check_home once lib/
# is loaded, before anything is written.
PRAETORIAN_HOME="${PRAETORIAN_HOME:-${HOME}/praetorian}"
readonly PRAETORIAN_HOME
readonly LOG_DIR="${PRAETORIAN_HOME}/logs"
readonly LOG_RETENTION=30          # number of log files to keep…
readonly LOG_MIN_AGE_DAYS=7        # …but none younger than this is removed
readonly UNUSED_THRESHOLD_DAYS=180 # 6 months
readonly APP_DIR="/Applications"
# Quarantine: one package per line, tab-separated fields:
#   name  type(formula|cask|port)  epoch  cause(xcode|pkg|build)  detail
readonly QUARANTINE_FILE="${PRAETORIAN_HOME}/quarantine.tsv"
readonly QUARANTINE_DAYS=30
# Build failures: often fixed by a new formula revision, so retried sooner.
readonly QUARANTINE_BUILD_DAYS=7
# Toolchain seen by the previous session ("xcode" or "clt"): when it
# changes, build failures deserve another try.
readonly TOOLCHAIN_FILE="${PRAETORIAN_HOME}/.toolchain"
# MacPorts: fixed prefix, called by absolute path (under sudo too, so a
# "port" found in the PATH is never run as root).
# PRAETORIAN_PORT_PREFIX is for tests only. It can't be used to get a
# binary run as root: before the real sudo runs it, PORT_BIN must belong
# to root and be writable by root only (see port_bin_trusted).
readonly PORT_PREFIX="${PRAETORIAN_PORT_PREFIX:-/opt/local}"
readonly PORT_BIN="${PORT_PREFIX}/bin/port"
# Formulae migrated to MacPorts: formula  port  epoch
readonly MIGRATED_FILE="${PRAETORIAN_HOME}/migrated.tsv"
# Lock: one session at a time (two brew/port runs on the same packages
# corrupt installs).
readonly LOCK_DIR="${PRAETORIAN_HOME}/.lock"
# Free disk space (GB): blocking below MIN_FREE_GB (a build that fills the
# disk leaves half-installed packages), warning below WARN_FREE_GB.
# PRAETORIAN_MIN_FREE_GB: tests.
readonly MIN_FREE_GB="${PRAETORIAN_MIN_FREE_GB:-5}"
readonly WARN_FREE_GB=20
# Unattended: how long to wait for the network before blocking (seconds).
# PRAETORIAN_NETWORK_WAIT: checked by check_network.
readonly NETWORK_WAIT="${PRAETORIAN_NETWORK_WAIT:-300}"
# Shell startup files (relative to $HOME) searched for Homebrew paths
# before a formula is uninstalled.
readonly SHELL_RC_FILES=(.zshenv .zprofile .zshrc .zlogin .bash_profile .bashrc .profile .config/fish/config.fish)

# Unique timestamp for the session
RUN_TS="$(date +%Y%m%d_%H%M%S)"
readonly RUN_TS
readonly LOG_FILE="${LOG_DIR}/praetorian_${RUN_TS}.log"
# Session start (epoch), for its duration in the summary and the
# notification.
SESSION_START=$(date +%s)
readonly SESSION_START
# From a terminal, a notification only after a session this long
# (seconds). PRAETORIAN_NOTIFY_AFTER: checked by notify_wanted.
readonly NOTIFY_AFTER="${PRAETORIAN_NOTIFY_AFTER:-300}"

# Options (changed by flags)
MODE=maintain               # maintain | report | migrate | status | doctor | prune | sbom
MIGRATE_SPEC=""             # spec being migrated: "formula" or "formula=port[,port…]"
declare -a MIGRATE_SPECS=() # every --migrate given, in order
MIGRATE_ALL=false           # --migrate-all
ALLOW_BUILD=false           # --allow-build: migrate even without a MacPorts binary
DRY_RUN=false
GREEDY=true
QUIET=false
RETRY_QUARANTINED=false
UNATTENDED=false           # --unattended, or automatic without a terminal
NOTIFY=auto                # auto | always (--notify) | never (--no-notify)
AC_POWER_ONLY=false        # --ac-power-only: blocked on battery
SHOW_PROGRESS=true         # progress line (off during casks)
declare -a DEFERRED=()     # deferred for lack of sudo (unattended mode)
declare -a SUDO_CMD=(sudo) # "sudo -n" when unattended: never waits

# Package managers found (see detect_managers)
HAS_BREW=false
HAS_PORT=false

# Result counters
declare -i STEP_OK=0
declare -i STEP_FAIL=0
declare -a FAILED_STEPS=()
declare -a PROBLEMS=() # brew/port errors pulled from the output (deduplicated)
declare -a NEWLY_QUARANTINED=()
declare -a BLOCKERS=() # blocks explained by block()

# Output of the last step run by run_step (for analysis).
STEP_OUT=""
STEP_PID=""            # PID of the running command (run_step)
CURRENT_STEP=""        # label of the running step (error messages)
LAST_BUILD_FAILS=""    # formulae whose build failed in the last step
SESSION_QUARANTINED="" # names quarantined during this session
LOCK_HELD=false
PORT_LAST_OUT=""  # output of the last read-only port command (port_ro)
OUTDATED_PORTS="" # outdated ports, one per line (port_refresh_outdated)

# ----------------------------------------------------------------------------
# Code loading
#
# The code is split by topic in lib/. Those files run with your rights and
# start commands under sudo, so every one is checked before anything is
# loaded: fixed list (no other file is ever loaded), regular file (no
# symbolic link), owned by you or root, not writable by group or others,
# and the same for the lib/ directory. Any problem stops praetorian before
# it does anything.
# ----------------------------------------------------------------------------
readonly PRAETORIAN_LIBS=(ui session quarantine brew macports migrate report doctor prune status sbom)

# Real directory of this script, symbolic links resolved.
praetorian_dir() {
    local src=${BASH_SOURCE[0]} dir
    while [[ -L "${src}" ]]; do
        dir=$(CDPATH='' cd -P "$(dirname "${src}")" && pwd)
        src=$(readlink "${src}")
        [[ "${src}" == /* ]] || src="${dir}/${src}"
    done
    CDPATH='' cd -P "$(dirname "${src}")" && pwd
}

# lib_problem <path> <f|d>: why the path can't be trusted, nothing if it can.
lib_problem() {
    local path=$1 kind=$2 uid
    uid=$(id -u)
    if [[ -L "${path}" ]]; then
        echo "is a symbolic link"
    elif [[ "${kind}" == d && ! -d "${path}" ]] || [[ "${kind}" == f && ! -f "${path}" ]]; then
        echo "is missing"
    elif [[ -n "$(find "${path}" -maxdepth 0 ! -user "${uid}" ! -user 0)" ]]; then
        echo "belongs to another user"
    elif [[ -n "$(find "${path}" -maxdepth 0 \( -perm -0020 -o -perm -0002 \))" ]]; then
        echo "is writable by group or others"
    fi
}

# Checks lib/ and every file in PRAETORIAN_LIBS; on any problem, explains
# it (block() isn't loaded yet, hence plain output) and stops.
check_libs() {
    local root=$1 dir="$1/lib" lib problem p
    local -a problems=()
    problem=$(lib_problem "${dir}" d)
    [[ -z "${problem}" ]] || problems+=("lib/ ${problem}")
    if [[ -d "${dir}" && ! -L "${dir}" ]]; then
        for lib in "${PRAETORIAN_LIBS[@]}"; do
            problem=$(lib_problem "${dir}/${lib}.sh" f)
            [[ -z "${problem}" ]] || problems+=("lib/${lib}.sh ${problem}")
        done
    fi
    ((${#problems[@]} > 0)) || return 0
    {
        echo ""
        echo "✗ BLOCKED: praetorian's code in lib/ can't be trusted"
        echo "    Why        : praetorian loads its code from ${dir} and runs commands under sudo with it."
        echo "                 These files fail the safety check:"
        for p in "${problems[@]}"; do
            echo "                   - ${p}"
        done
        echo "    Impact     : Nothing was done: no command was run, no log was written."
        echo "    What to do :"
        echo "        First check that nobody changed the code:  git -C ${root} status && git -C ${root} diff"
        echo "        Missing file:     git -C ${root} checkout -- lib/"
        echo "        Writable:         chmod go-w ${dir} ${dir}/*.sh"
        echo "        Another owner:    chown $(id -un 2>/dev/null || id -u) ${dir} ${dir}/*.sh   (after checking the content)"
        echo "        Symbolic link:    replace it with the real file from the repository"
        echo "    Log        : none (this check runs before logging starts)"
        echo ""
    } >&2
    exit 1
}

# Never as root. Checked before check_libs: under sudo, lib/ belongs to
# the user, not to root, and the lib/ check would report a misleading
# "belongs to another user". lib/session.sh checks it again (harmless).
check_not_root() {
    [[ "${EUID}" -eq 0 ]] || return 0
    {
        echo ""
        echo "✗ BLOCKED: praetorian was started as root"
        echo "    Why        : Homebrew refuses to run as root, and praetorian asks for sudo itself, one command at a time, only when MacPorts or a cask needs it."
        echo "    Impact     : Nothing was done: no command was run, no log was written."
        echo "    What to do : Run it again without sudo: ${PRAETORIAN_ROOT}/praetorian"
        echo "    Log        : none (this check runs before logging starts)"
        echo ""
    } >&2
    exit 1
}

PRAETORIAN_ROOT=$(praetorian_dir)
readonly PRAETORIAN_ROOT
check_not_root
check_libs "${PRAETORIAN_ROOT}"
# Same order as PRAETORIAN_LIBS. Written out so ShellCheck follows them.
# shellcheck source=lib/ui.sh
source "${PRAETORIAN_ROOT}/lib/ui.sh"
# shellcheck source=lib/session.sh
source "${PRAETORIAN_ROOT}/lib/session.sh"
# shellcheck source=lib/quarantine.sh
source "${PRAETORIAN_ROOT}/lib/quarantine.sh"
# shellcheck source=lib/brew.sh
source "${PRAETORIAN_ROOT}/lib/brew.sh"
# shellcheck source=lib/macports.sh
source "${PRAETORIAN_ROOT}/lib/macports.sh"
# shellcheck source=lib/migrate.sh
source "${PRAETORIAN_ROOT}/lib/migrate.sh"
# shellcheck source=lib/report.sh
source "${PRAETORIAN_ROOT}/lib/report.sh"
# shellcheck source=lib/doctor.sh
source "${PRAETORIAN_ROOT}/lib/doctor.sh"
# shellcheck source=lib/prune.sh
source "${PRAETORIAN_ROOT}/lib/prune.sh"
# shellcheck source=lib/status.sh
source "${PRAETORIAN_ROOT}/lib/status.sh"
# shellcheck source=lib/sbom.sh
source "${PRAETORIAN_ROOT}/lib/sbom.sh"

# PRAETORIAN_HOME must be an absolute path on one line: a relative one
# would follow the current directory, a newline would break the paths
# written to the log. Plain output: block() writes to the log, which
# lives under that very directory.
check_home() {
    if [[ "${PRAETORIAN_HOME}" == /* && "${PRAETORIAN_HOME}" != *$'\n'* ]]; then
        return 0
    fi
    {
        echo ""
        echo "${C_RED}${C_BOLD}✗ BLOCKED: PRAETORIAN_HOME is not usable${C_RESET}"
        echo "    Why        : PRAETORIAN_HOME must be an absolute path on a single line; got: $(printf '%q' "${PRAETORIAN_HOME}")"
        echo "    Impact     : Nothing was done: no command was run, no log was written."
        echo "    What to do : Set an absolute path, e.g. export PRAETORIAN_HOME=\"\${HOME}/praetorian\","
        echo "                 or unset it to use the default (~/praetorian)."
        echo ""
    } >&2
    finish 1
}
check_home

# ----------------------------------------------------------------------------
# Help
# ----------------------------------------------------------------------------
usage() {
    cat <<EOF
${C_BOLD}praetorian ${PRAETORIAN_VERSION}${C_RESET} — Homebrew and MacPorts maintenance for macOS

Usage: praetorian [options]
       praetorian --migration-report
       praetorian [--dry-run] --migrate <formula>[=<port>]

Options:
  --dry-run     Simulates without changing anything (shows the planned steps).
  --no-greedy   Doesn't use --greedy for casks (lets self-updating apps
                handle themselves).
  --retry-quarantined
                Also retries the quarantined packages.
  --unattended  Nobody watching (overnight, launchd): nothing waits for
                input, whatever needs sudo (casks with an installer, the
                whole MacPorts part) is deferred, and a macOS notification
                summarizes the session. Automatic when praetorian isn't
                started from a terminal.
                No password is ever stored (CIS / PCI DSS).
  --notify      Always sends the end-of-session notification, even for a
                short session or a dry-run (handy to check that macOS lets
                it through). By default: unattended, or after a session of
                5 minutes or more.
  --no-notify   Never sends it.
  --ac-power-only
                Blocks the session when the Mac runs on battery (used by
                praetorian-schedule: hours of builds would drain it).
  --quiet       Minimal screen output (everything stays in the log; blocks
                are always shown).
  --help, -h    Shows this help.

Homebrew → MacPorts migration:
  --migration-report
                Read-only plan: for each formula you installed yourself, the
                matching MacPorts port, and what would block its migration.
                Changes nothing.
  --migrate <formula>[=<port>[,<port>…]]
                Migrates a formula: checks (dependents, service, paths in
                the shell, programs outside Homebrew that use it), installs
                the port(s), checks that every command of the formula is
                now found in MacPorts, and only then uninstalls the formula.
                Extra ports after a comma are companions installed with it.
                Repeat --migrate for several formulae (one session).
                E.g.: --migrate wget   --migrate python@3.12=python312
                      --migrate step=step-cli,step-ca
                (--migrate=<spec> works too)
  --migrate-all Migrates every formula the report finds under the same
                name in MacPorts, leaves first; a blocked one is skipped
                and listed in the summary.
  --allow-build Migrates even when MacPorts has no precompiled binary of
                the port for this Mac (it would compile from source).

Status and cleanup:
  --status      Read-only: what is migrated, what is left in Homebrew and
                why, removable leftovers, and the last sessions.
  --doctor      Read-only health check: broken pipx environments, files
                Homebrew can't clean, dead PATH entries, broken links,
                ports MacPorts could remove by mistake… with the command
                that fixes each one.
  --prune       Removes the Homebrew dependencies nothing uses any more
                (what brew autoremove misses), asking before each round.
                With --dry-run: only lists them. Never when unattended.
  --sbom        Writes a CycloneDX 1.6 SBOM of the installed software
                (Homebrew, MacPorts, apps, pipx, npm) in the logs
                directory, with the changes since the previous one.

Logs       : ${LOG_DIR}/praetorian_<date>.log (last ${LOG_RETENTION} kept, plus every one under ${LOG_MIN_AGE_DAYS} days)
Quarantine : ${QUARANTINE_FILE} (expires after ${QUARANTINE_DAYS} d)
EOF
}

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
# Formula/port names: safe characters only (they end up in grep/awk
# patterns, URLs and commands run under sudo). "/" only on the formula
# side, for tap formulae (hashicorp/tap/terraform). Several ports are
# separated by commas (a main port and its companions: step=step-cli,step-ca).
valid_migrate_spec() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9@._+/-]*(=[A-Za-z0-9][A-Za-z0-9@._+-]*(,[A-Za-z0-9][A-Za-z0-9@._+-]*)*)?$ ]] &&
        [[ "$1" != *..* && "$1" != */=* && "${1%%=*}" != */ ]]
}

# set_mode <mode> <option>: one mode per run (--status and --prune
# together would be ambiguous). --migrate may be repeated.
set_mode() {
    if [[ "${MODE}" != maintain && "${MODE}" != "$1" ]]; then
        err "$2 can't be combined with another mode option (--migration-report, --migrate, --migrate-all, --status, --doctor, --prune, --sbom)."
        finish 1
    fi
    MODE=$1
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=true ;;
            --no-greedy) GREEDY=false ;;
            --retry-quarantined) RETRY_QUARANTINED=true ;;
            --unattended) UNATTENDED=true ;;
            --notify) NOTIFY=always ;;
            --no-notify) NOTIFY=never ;;
            --ac-power-only) AC_POWER_ONLY=true ;;
            --quiet) QUIET=true ;;
            --migration-report) set_mode report "$1" ;;
            --status) set_mode status "$1" ;;
            --doctor) set_mode doctor "$1" ;;
            --prune) set_mode prune "$1" ;;
            --sbom) set_mode sbom "$1" ;;
            --allow-build) ALLOW_BUILD=true ;;
            --migrate-all)
                set_mode migrate "$1"
                MIGRATE_ALL=true
                ;;
            --migrate | --migrate=*)
                local spec
                if [[ "$1" == --migrate=* ]]; then
                    spec=${1#--migrate=}
                else
                    spec=${2:-}
                    [[ $# -gt 1 ]] && shift
                fi
                if ! valid_migrate_spec "${spec}"; then
                    err "--migrate expects a formula name, optionally followed by =<port> (several ports: =<port>,<port>)."
                    err "Examples: --migrate wget    --migrate python@3.12=python312    --migrate step=step-cli,step-ca"
                    finish 1
                fi
                set_mode migrate --migrate
                MIGRATE_SPECS+=("${spec}")
                MIGRATE_SPEC=${MIGRATE_SPECS[0]}
                ;;
            --help | -h)
                usage
                finish 0
                ;;
            *)
                err "Unknown option: $1"
                usage
                finish 1
                ;;
        esac
        shift
    done
}

# ----------------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------------
main() {
    parse_args "$@"

    # fd 3 = original stdin: commands started in the background by
    # run_step would otherwise get /dev/null (no sudo password).
    exec 3<&0

    # Keeps the Mac awake for the whole session (long builds on Intel;
    # sleep used to cut the network in the middle of the night).
    if [[ -z "${PRAETORIAN_CAFFEINATED:-}" && "${DRY_RUN}" != true ]] &&
        [[ "${MODE}" != report && "${MODE}" != status && "${MODE}" != doctor && "${MODE}" != sbom ]] &&
        command -v caffeinate >/dev/null 2>&1; then
        export PRAETORIAN_CAFFEINATED=1
        exec caffeinate -i "$0" "$@"
    fi

    # No terminal (launchd, cron, pipe): nobody to type a password, switch
    # to unattended rather than hang.
    [[ -t 0 ]] || UNATTENDED=true
    if [[ "${UNATTENDED}" == true ]]; then
        # Homebrew then calls "sudo -A": refused right away, no waiting.
        export SUDO_ASKPASS=/usr/bin/false
        # MacPorts: "sudo -n" fails right away instead of waiting.
        SUDO_CMD=(sudo -n)
    fi

    check_prerequisites

    # Read-only modes: no lock, no Xcode/network/disk checks, nothing
    # installed or removed. Their return code is passed on with errexit
    # suspended for that one call (same reason as summary below): a
    # non-zero return would otherwise stop the script as an "unexpected
    # error".
    local mode_rc=0
    case "${MODE}" in
        report)
            migration_report
            ((${#BLOCKERS[@]} == 0)) || finish 1
            finish 0
            ;;
        status)
            set +e
            status_run
            mode_rc=$?
            set -e
            finish "${mode_rc}"
            ;;
        doctor)
            # doctor_run always returns 0 (a non-zero return would stop
            # the session through set -e): its verdict is DOCTOR_RC.
            doctor_run
            finish "${DOCTOR_RC}"
            ;;
        sbom)
            set +e
            sbom_run
            mode_rc=$?
            set -e
            finish "${mode_rc}"
            ;;
    esac

    [[ "${DRY_RUN}" == true ]] || check_xcode_ready
    check_ac_power
    check_network
    check_disk_space
    acquire_lock
    quarantine_prune

    say "${C_BOLD}praetorian ${PRAETORIAN_VERSION}${C_RESET} — $(date '+%Y-%m-%d %H:%M')"
    [[ "${DRY_RUN}" == true ]] && warn "Dry-run mode: no change will be applied."
    platform_notes

    if [[ "${MODE}" == migrate ]]; then
        migrate_batch
    elif [[ "${MODE}" == prune ]]; then
        prune_run
    else
        if [[ "${HAS_BREW}" == true ]]; then
            maintenance_brew
        else
            info "Homebrew not found: Homebrew part skipped."
        fi
        if [[ "${HAS_PORT}" == true ]]; then
            maintenance_macports
        fi
        coexistence
        diagnostics
        find_unused_apps
    fi
    rotate_logs

    # summary returns 2 when something failed; pass the code on. Not
    # "summary || final_rc=$?": that would turn set -e off inside summary
    # without saying so. errexit is suspended explicitly for this one
    # call instead (summary only prints), then restored.
    local final_rc=0
    set +e
    summary
    final_rc=$?
    set -e
    finish "${final_rc}"
}

# Run main only when executed, not when sourced (the unit tests source
# this file to call single functions).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
